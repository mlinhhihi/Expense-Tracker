<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FAFAFAF5"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="4dp"
            android:layout_marginTop="-20dp"
            android:backgroundTint="#8B5A2B"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="50dp"
                android:paddingBottom="30dp"
                android:paddingHorizontal="24dp">

                <androidx.cardview.widget.CardView
                    android:id="@+id/cardAvatarClick"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    app:cardCornerRadius="32dp"
                    app:cardElevation="0dp"
                    android:backgroundTint="#F5ECE3"
                    android:clickable="false"
                    android:focusable="false"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent">

                    <ImageView
                        android:id="@+id/imgAvatar"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/ic_me"
                        android:scaleType="centerCrop"
                        android:padding="0dp"/>
                </androidx.cardview.widget.CardView>

                <TextView
                    android:id="@+id/txtHeaderName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Người dùng"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginStart="16dp"
                    app:layout_constraintTop_toTopOf="@id/cardAvatarClick"
                    app:layout_constraintBottom_toTopOf="@id/btnViewInfo"
                    app:layout_constraintStart_toEndOf="@id/cardAvatarClick"
                    app:layout_constraintEnd_toEndOf="parent"/>

                <TextView
                    android:id="@+id/btnViewInfo"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:text="Thông tin cá nhân >"
                    android:textColor="#F5ECE3"
                    android:textSize="14sp"
                    android:layout_marginTop="4dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:layout_constraintTop_toBottomOf="@id/txtHeaderName"
                    app:layout_constraintBottom_toBottomOf="@id/cardAvatarClick"
                    app:layout_constraintStart_toStartOf="@id/txtHeaderName"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.cardview.widget.CardView>

        <Button
            android:id="@+id/btnLogout"
            android:layout_width="0dp"
            android:layout_height="55dp"
            android:layout_marginHorizontal="20dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#FFEBEE"
            android:text="Đăng xuất"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#C62828"
            app:layout_constraintTop_toBottomOf="@id/cardHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutViewProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnLogout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/lblTitleView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chi tiết tài khoản"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#5C3A21"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <TextView
                android:id="@+id/txtViewEmail"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Email: "
                android:textColor="#5C3A21"
                android:textSize="16sp"
                android:paddingVertical="12dp"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/lblTitleView"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/txtViewName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Họ và tên: "
                android:textColor="#5C3A21"
                android:textSize="16sp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtViewEmail"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <TextView
                android:id="@+id/txtViewBirth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Ngày sinh: "
                android:textColor="#5C3A21"
                android:textSize="16sp"
                android:paddingVertical="12dp"
                app:layout_constraintTop_toBottomOf="@id/txtViewName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/btnGoToEdit"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#8B5A2B"
                android:text="Chỉnh sửa thông tin"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/txtViewBirth"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutEditProfile"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:padding="20dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnLogout"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/lblTitleEdit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỉnh sửa hồ sơ"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#5C3A21"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"/>

            <EditText
                android:id="@+id/edtEmailProfile"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="16dp"
                android:hint="Email"
                android:enabled="false"
                android:padding="14dp"
                android:backgroundTint="#A89F95"
                android:textColor="#A89F95"
                app:layout_constraintTop_toBottomOf="@id/lblTitleEdit"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <EditText
                android:id="@+id/edtFullName"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Họ và tên"
                android:inputType="textPersonName"
                android:padding="14dp"
                android:backgroundTint="#A0522D"
                android:textColor="#5C3A21"
                android:textColorHint="#8A7E72"
                app:layout_constraintTop_toBottomOf="@id/edtEmailProfile"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <EditText
                android:id="@+id/txtBirthDate"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:hint="Ngày sinh (ngày/tháng/năm)"
                android:inputType="date"
                android:padding="14dp"
                android:backgroundTint="#A0522D"
                android:textColor="#5C3A21"
                android:textColorHint="#8A7E72"
                app:layout_constraintTop_toBottomOf="@id/edtFullName"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/btnUpdateProfile"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="#8B5A2B"
                android:text="Lưu thay đổi"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                app:layout_constraintTop_toBottomOf="@id/txtBirthDate"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>

            <Button
                android:id="@+id/btnBackToView"
                android:layout_width="0dp"
                android:layout_height="55dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="20dp"
                android:backgroundTint="#EFEBE9"
                android:text="Quay lại"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#5C3A21"
                app:layout_constraintTop_toBottomOf="@id/btnUpdateProfile"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"/>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>